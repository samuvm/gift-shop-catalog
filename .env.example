# Copy to .env and fill in. Never commit .env.

# API key that callers must send in the X-API-Key header.
CATALOG_API_KEY=change-me

# Workspace token of the indigo.ai web chat, embedded in the landing page at /.
# Leave empty to serve the page without the chat.
WIDGET_TOKEN=

# Time zone used for "today" (shipping deadlines). Defaults to Europe/Rome.
SHOP_TIMEZONE=Europe/Rome

# Only for the remote checks (make latency / make check-public): the agent's test page.
TEST_PAGE_URL=
